{
  "site": { "title": "Third Pour", "framework": "static" },
  "hints": {
    "stableSelectors": ["[data-testid]"],
    "notes": "Drives `npm run demo`. Every state's trigger is visible on all devices (the mobile drawer is left to device-aware auto-discovery via `demo:crawl`). Theme toggle adds `.dark` to <html>."
  },
  "routes": [
    {
      "id": "home",
      "url": "/",
      "depth": 0,
      "states": [
        { "id": "default", "kind": "default", "label": "Default", "recipe": [], "shots": {} },
        {
          "id": "dark",
          "kind": "other",
          "label": "Dark mode",
          "trigger": { "testId": "theme-toggle" },
          "recipe": [
            { "action": "click", "target": { "testId": "theme-toggle" } },
            { "action": "waitFor", "selector": "html.dark", "state": "attached" }
          ],
          "shots": {}
        },
        {
          "id": "search-open",
          "kind": "modal",
          "label": "Search modal",
          "trigger": { "testId": "search-button" },
          "recipe": [
            { "action": "click", "target": { "testId": "search-button" } },
            { "action": "waitFor", "selector": "#search-modal[open]", "state": "visible" }
          ],
          "shots": {}
        },
        {
          "id": "newsletter-open",
          "kind": "modal",
          "label": "Newsletter modal",
          "trigger": { "testId": "subscribe-button" },
          "recipe": [
            { "action": "click", "target": { "testId": "subscribe-button" } },
            { "action": "waitFor", "selector": "#newsletter-modal[open]", "state": "visible" }
          ],
          "shots": {}
