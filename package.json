{
  "name": "visual-crawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crawl a website and capture every page and UI state across devices, then view them on a zoomable canvas.",
  "bin": {
    "visual-crawl": "bin/visual-crawl.mjs"
  },
  "scripts": {
    "vc": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts demo",
    "demo:crawl": "tsx src/cli.ts demo-crawl",
    "crawl": "tsx src/cli.ts crawl",
    "discover": "tsx src/cli.ts discover",
    "capture": "tsx src/cli.ts capture",
    "serve": "tsx src/cli.ts serve",
    "viewer:build": "vite build viewer",
    "viewer:dev": "vite viewer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.2",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
