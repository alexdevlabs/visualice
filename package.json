{
  "name": "visualice",
  "version": "0.1.0",
  "type": "module",
  "description": "Crawl a website and capture every page and UI state across devices, then view them on a zoomable canvas.",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "visualice": "bin/visualice.mjs"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config.schema.json": "./config.schema.json"
  },
  "scripts": {
    "vc": "tsx src/cli.ts",
    "build": "npm run build:node && npm run build:types && npm run viewer:build",
    "build:node": "vite build --config vite.node.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "demo": "tsx src/cli.ts demo",
    "demo:crawl": "tsx src/cli.ts demo-crawl",
    "fixture": "tsx src/cli.ts fixture",
    "fixture:build": "node tests/fixture-src/build.mjs",
    "crawl": "tsx src/cli.ts crawl",
    "discover": "tsx src/cli.ts discover",
    "capture": "tsx src/cli.ts capture",
    "auth": "tsx src/cli.ts auth",
    "serve": "tsx src/cli.ts serve",
    "schema": "tsx scripts/gen-schema.ts",
    "viewer:build": "vite build viewer",
    "viewer:dev": "vite viewer",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright": "^1.61.0",
    "sharp": "^0.34.2",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  },
  "files": [
    "bin",
    "dist",
    "viewer/dist",
    "tests/fixture",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ]
}
